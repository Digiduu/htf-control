NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Service role key del progetto Supabase (Project Settings > API > service_role).
# SOLO server-side: usata esclusivamente da app/lib/supabase/admin.ts per creare,
# bannare, resettare la password ed eliminare utenti dall'area Amministrazione.
# Non deve MAI avere il prefisso NEXT_PUBLIC_ e non va mai esposta al browser.
SUPABASE_SERVICE_ROLE_KEY=

# Integrazione Odoo (modulo oriens_htf_control): iframe SSO incastonato nel
# backend Odoo. Il secret deve combaciare col system parameter
# `htf_control.sso_secret` su Odoo, l'origin con `htf_control.base_url`.
# SOLO server-side, non va MAI esposta al browser (niente prefisso NEXT_PUBLIC_).
HTF_CONTROL_SSO_SECRET=
# Origin Odoo autorizzate a incastonare l'app in iframe, separate da spazio.
HTF_CONTROL_FRAME_ANCESTORS=http://localhost:8079
